# codebaserag — docker compose environment (dev-local only). Copy to .env:
#   cp .env.example .env
#
# Database credentials fail closed: the stack refuses to start without them.

# --- default stack (pgvector + API) ---
CODERAG_DB_USER=coderag
CODERAG_DB_PASSWORD=change-me-local-dev
CODERAG_DB_NAME=coderag

# --- optional observability stack (docker compose --profile langfuse up) ---
# No credentials live inline in docker-compose.yml (SonarQube secrets:S6698).
LANGFUSE_DATABASE_URL=postgresql://langfuse:langfuse@langfuse-db:5432/langfuse
LANGFUSE_CLICKHOUSE_URL=clickhouse://default:langfuse-clickhouse@clickhouse:8123/default
