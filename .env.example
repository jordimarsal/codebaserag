# codebaserag environment (copy to .env)
# All variables are read by the app via the CODERAG_ prefix (pydantic-settings).

# --- Postgres / pgvector (service name "db") ---
CODERAG_DB_USER=coderag
CODERAG_DB_PASSWORD=coderag
CODERAG_DB_NAME=coderag
CODERAG_DATABASE_DSN=postgresql://coderag:coderag@db:5432/coderag

# --- App ---
CODERAG_REPO=/repo
CODERAG_VECTOR_STORE=pgvector
CODERAG_APP_PORT=8000

# --- Embeddings ---
# Backend: "ollama" (default) or "llamacpp" (llama.cpp OpenAI-compatible server).
# For llama.cpp, point CODERAG_EMBEDDER_URL at its server (e.g. http://localhost:8080).
CODERAG_EMBEDDER_BACKEND=ollama
CODERAG_EMBEDDER_URL=http://host.docker.internal:11434
CODERAG_EMBEDDER_MODEL=nomic-embed-text

# --- LLM ---
CODERAG_LLM_BACKEND=litellm
CODERAG_LLM_MODEL=gpt-4o-mini

# --- Retrieval / rerank ---
CODERAG_RETRIEVAL_STRATEGY=dense
CODERAG_BM25_BACKEND=postgres
CODERAG_RERANK_MODEL=bge-reranker-base

# --- Qdrant (only when using the qdrant profile) ---
CODERAG_QDRANT_URL=http://qdrant:6333
CODERAG_QDRANT_COLLECTION=coderag
CODERAG_QDRANT_DISTANCE=Cosine
CODERAG_QDRANT_PORT=6333

# --- Observability (Langfuse; enable with the langfuse profile) ---
CODERAG_OBSERVABILITY_BACKEND=none
CODERAG_LANGFUSE_HOST=http://langfuse-server:3000
CODERAG_LANGFUSE_PUBLIC_KEY=pk-lf-dev
CODERAG_LANGFUSE_SECRET_KEY=sk-lf-dev

# --- Langfuse stack secrets (langfuse profile) ---
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse-clickhouse
LANGFUSE_SALT=change-me-salt
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth
LANGFUSE_PORT=3000
