  "cards": [
    {
      "dot": "emerald",
      "title": "Backends",
      "items": [
        "memory + HashEmbedder: offline, rebuilds the index per process",
        "pgvector: default persistent store, with Postgres FTS for BM25",
        "Qdrant adapter and Tantivy BM25 for the persistent variants",
        "LlamaIndex SimpleVectorStore behind the same VectorStore port",
        "Tracer: no-op by default, Langfuse when keys are present"
      ]
    },
    {
      "dot": "amber",
      "title": "Ingest bounds",
      "items": [
        "Fixed 40-line chunks from .py, .md, .toml and .yaml readers",
        "Caps: 1 MB per file, 10k files, 64 MB total",
        "Embeddings are batched (64) and upserted only after all vectors return"
      ]
    },
    {
      "dot": "rose",
      "title": "Eval gate",
      "items": [
        "44 golden Q/A over this repo: recall@5, MRR and nDCG@5",
        "baseline.json records mean recall@5 0.409 with a real embedder",
        "CI runs Ruff, Black, strict Mypy and pytest; eval is on demand"
      ]
    }
  ]
